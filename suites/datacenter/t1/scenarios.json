{
  "surface": "datacenter",
  "tier": "t1",
  "specs": ["dc-9.0.1", "dc-9.2.4", "dc-9.5.1", "dc-10.2.20", "dc-11.1.0"],
  "contracts": ["aerie-dc-contracts-v3"],
  "admin_as": "token:lab-admin-pat",
  "_admin_as": "Credential for fixture lookups and setup steps: the administrator's personal access token as a bearer token. Basic with a token in the password field is tested by suites/auth.",
  "fixtures": {
    "lab_home": {"path": "/rest/api/content", "params": {"spaceKey": "LAB", "title": "Lab Home"}, "pick": "results.0.id"},
    "priv_home": {"path": "/rest/api/content", "params": {"spaceKey": "PRIV", "title": "Private Home"}, "pick": "results.0.id"}
  },
  "_checks": "expect maps each allowed status to its checks: [exists, path] [eq, path, value] [len_le|len_ge, path, n] [none_eq, list_path, field_path, value]. Statuses follow the response descriptions in the pinned spec files.",
  "scenarios": [
    {"id": "content.list.success", "op": "GET /rest/api/content", "as": "user", "params": {"spaceKey": "LAB", "type": "page"},
     "expect": {"200": [["len_ge", "results", 1], ["exists", "results.0.id"], ["eq", "results.0.type", "page"], ["exists", "_links.base"]]}},
    {"id": "content.list.paging", "op": "GET /rest/api/content", "as": "user", "params": {"spaceKey": "LAB", "limit": 5, "start": 0},
     "expect": {"200": [["len_le", "results", 5], ["eq", "limit", 5], ["eq", "start", 0], ["exists", "_links.next"]]}},
    {"id": "content.list.expand", "op": "GET /rest/api/content", "as": "user", "params": {"spaceKey": "LAB", "title": "Lab Home", "expand": "body.storage,version,space"},
     "expect": {"200": [["exists", "results.0.body.storage.value"], ["exists", "results.0.version.number"], ["eq", "results.0.space.key", "LAB"]]}},
    {"id": "content.list.not_allowed", "op": "GET /rest/api/content", "as": "user", "params": {"spaceKey": "PRIV"},
     "expect": {"200": [["eq", "size", 0]], "404": []}},
    {"id": "content.list.not_found", "op": "GET /rest/api/content", "as": "user", "params": {"spaceKey": "NOSUCHSPACE"},
     "expect": {"200": [["eq", "size", 0]], "404": []}},

    {"id": "content.get.success", "op": "GET /rest/api/content/{id}", "as": "user", "path": {"id": "{lab_home}"},
     "expect": {"200": [["eq", "id", "{lab_home}"], ["eq", "type", "page"], ["eq", "title", "Lab Home"], ["exists", "_links.self"]]}},
    {"id": "content.get.expand", "op": "GET /rest/api/content/{id}", "as": "user", "path": {"id": "{lab_home}"}, "params": {"expand": "body.storage,version,ancestors,space"},
     "expect": {"200": [["exists", "body.storage.value"], ["eq", "body.storage.representation", "storage"], ["exists", "version.number"], ["eq", "space.key", "LAB"]]}},
    {"id": "content.get.not_found", "op": "GET /rest/api/content/{id}", "as": "user", "path": {"id": "999999999"},
     "expect": {"404": []}},
    {"id": "content.get.not_allowed", "op": "GET /rest/api/content/{id}", "as": "user", "path": {"id": "{priv_home}"},
     "expect": {"404": []}},

    {"id": "content.children.success", "op": "GET /rest/api/content/{id}/child", "as": "user", "path": {"id": "{lab_home}"}, "params": {"expand": "page"},
     "expect": {"200": [["eq", "page.size", 12], ["exists", "page.results.0.id"]]}},
    {"id": "content.child_pages.success", "op": "GET /rest/api/content/{id}/child/{type}", "as": "user", "path": {"id": "{lab_home}", "type": "page"},
     "expect": {"200": [["eq", "size", 12], ["eq", "results.0.title", "Lab Child 01"]]}},
    {"id": "content.child_pages.paging", "op": "GET /rest/api/content/{id}/child/{type}", "as": "user", "path": {"id": "{lab_home}", "type": "page"}, "params": {"limit": 5, "start": 5},
     "expect": {"200": [["eq", "size", 5], ["eq", "start", 5], ["eq", "limit", 5], ["eq", "results.0.title", "Lab Child 06"], ["exists", "_links.next"], ["exists", "_links.prev"]]}},
    {"id": "content.child_pages.expand", "op": "GET /rest/api/content/{id}/child/{type}", "as": "user", "path": {"id": "{lab_home}", "type": "page"}, "params": {"expand": "version,ancestors"},
     "expect": {"200": [["exists", "results.0.version.number"], ["eq", "results.0.ancestors.0.id", "{lab_home}"]]}},
    {"id": "content.child_pages.not_found", "op": "GET /rest/api/content/{id}/child/{type}", "as": "user", "path": {"id": "999999999", "type": "page"},
     "expect": {"404": []}},
    {"id": "content.child_pages.not_allowed", "op": "GET /rest/api/content/{id}/child/{type}", "as": "user", "path": {"id": "{priv_home}", "type": "page"},
     "expect": {"404": []}},

    {"id": "space.list.success", "op": "GET /rest/api/space", "as": "user",
     "expect": {"200": [["len_ge", "results", 1], ["exists", "results.0.key"], ["none_eq", "results", "key", "PRIV"]]}},
    {"id": "space.list.paging", "op": "GET /rest/api/space", "as": "token:lab-admin-pat", "params": {"limit": 1, "start": 0},
     "expect": {"200": [["eq", "size", 1], ["eq", "limit", 1], ["exists", "_links.next"]]}},
    {"id": "space.list.expand", "op": "GET /rest/api/space", "as": "user", "params": {"spaceKey": "LAB", "expand": "description.plain,homepage"},
     "note": "aerie spaces have no home page; expand=homepage is ignored (contracts-v2, behaviour/spaces.md).",
     "expect": {"200": [["eq", "results.0.key", "LAB"], ["exists", "results.0.description.plain.value"], ["missing", "results.0.homepage"]]}},
    {"id": "space.list.not_allowed", "op": "GET /rest/api/space", "as": "user", "params": {"spaceKey": "PRIV"},
     "expect": {"200": [["eq", "size", 0]]}},

    {"id": "space.get.success", "op": "GET /rest/api/space/{spaceKey}", "as": "user", "path": {"spaceKey": "LAB"},
     "expect": {"200": [["eq", "key", "LAB"], ["eq", "name", "Lab"], ["eq", "type", "global"], ["exists", "_links.self"]]}},
    {"id": "space.get.expand", "op": "GET /rest/api/space/{spaceKey}", "as": "user", "path": {"spaceKey": "LAB"}, "params": {"expand": "description.plain,homepage"},
     "expect": {"200": [["eq", "description.plain.value", "Lab fixture space"], ["missing", "homepage"]]}},
    {"id": "space.get.lowercase", "op": "GET /rest/api/space/{spaceKey}", "as": "user", "path": {"spaceKey": "lab"},
     "note": "Keys are accepted in any case and returned in upper case (contracts-v2, behaviour/spaces.md).",
     "expect": {"200": [["eq", "key", "LAB"]]}},
    {"id": "space.get.not_found", "op": "GET /rest/api/space/{spaceKey}", "as": "user", "path": {"spaceKey": "NOSUCHSPACE"},
     "expect": {"404": []}},
    {"id": "space.get.not_allowed", "op": "GET /rest/api/space/{spaceKey}", "as": "user", "path": {"spaceKey": "PRIV"},
     "expect": {"404": []}},

    {"id": "space.pages.success", "op": "GET /rest/api/space/{spaceKey}/content/{type}", "as": "user", "path": {"spaceKey": "LAB", "type": "page"},
     "expect": {"200": [["len_ge", "results", 13], ["exists", "results.0.id"]]}},
    {"id": "space.pages.root", "op": "GET /rest/api/space/{spaceKey}/content/{type}", "as": "user", "path": {"spaceKey": "LAB", "type": "page"}, "params": {"depth": "root"},
     "note": "Without a home page, clients walk the tree from the top level (contracts-v2, behaviour/spaces.md).",
     "expect": {"200": [["eq", "size", 1], ["eq", "results.0.title", "Lab Home"]]}},
    {"id": "space.pages.paging", "op": "GET /rest/api/space/{spaceKey}/content/{type}", "as": "user", "path": {"spaceKey": "LAB", "type": "page"}, "params": {"limit": 5},
     "expect": {"200": [["eq", "size", 5], ["eq", "limit", 5], ["exists", "_links.next"]]}},
    {"id": "space.pages.expand", "op": "GET /rest/api/space/{spaceKey}/content/{type}", "as": "user", "path": {"spaceKey": "LAB", "type": "page"}, "params": {"expand": "version,space"},
     "expect": {"200": [["exists", "results.0.version.number"], ["eq", "results.0.space.key", "LAB"]]}},
    {"id": "space.pages.not_found", "op": "GET /rest/api/space/{spaceKey}/content/{type}", "as": "user", "path": {"spaceKey": "NOSUCHSPACE", "type": "page"},
     "expect": {"404": []}},
    {"id": "space.pages.not_allowed", "op": "GET /rest/api/space/{spaceKey}/content/{type}", "as": "user", "path": {"spaceKey": "PRIV", "type": "page"},
     "expect": {"404": []}},

    {"id": "search.content.success", "op": "GET /rest/api/content/search", "as": "user", "params": {"cql": "space = LAB and type = page"},
     "expect": {"200": [["len_ge", "results", 13], ["exists", "results.0.id"], ["exists", "results.0.title"]]}},
    {"id": "search.content.paging", "op": "GET /rest/api/content/search", "as": "user", "params": {"cql": "space = LAB and type = page", "limit": 5},
     "expect": {"200": [["eq", "size", 5], ["eq", "limit", 5], ["exists", "_links.next"]]}},
    {"id": "search.content.expand", "op": "GET /rest/api/content/search", "as": "user", "params": {"cql": "space = LAB and title = \"Lab Home\"", "expand": "space,version"},
     "expect": {"200": [["eq", "results.0.space.key", "LAB"], ["exists", "results.0.version.number"]]}},
    {"id": "search.content.not_allowed", "op": "GET /rest/api/content/search", "as": "user", "params": {"cql": "space = PRIV"},
     "expect": {"200": [["eq", "size", 0]]}},
    {"id": "search.content.invalid_cql", "op": "GET /rest/api/content/search", "as": "user", "params": {"cql": "space = = ("},
     "note": "The spec documents 404 for invalid or missing CQL on this operation; 400 is accepted too until the spec room rules.",
     "expect": {"404": [], "400": []}},

    {"id": "search.site.success", "op": "GET /rest/api/search", "as": "user", "params": {"cql": "space = LAB and type = page"},
     "expect": {"200": [["len_ge", "results", 13], ["exists", "results.0.content.id"], ["exists", "results.0.title"], ["exists", "totalSize"]]}},
    {"id": "search.site.paging", "op": "GET /rest/api/search", "as": "user", "params": {"cql": "space = LAB and type = page", "limit": 5, "start": 5},
     "expect": {"200": [["eq", "size", 5], ["eq", "start", 5], ["eq", "limit", 5], ["exists", "_links.next"]]}},
    {"id": "search.site.expand", "op": "GET /rest/api/search", "as": "user", "params": {"cql": "space = LAB and title = \"Lab Home\"", "expand": "content.space"},
     "expect": {"200": [["eq", "results.0.content.space.key", "LAB"]]}},
    {"id": "search.site.not_allowed", "op": "GET /rest/api/search", "as": "user", "params": {"cql": "space = PRIV"},
     "expect": {"200": [["eq", "size", 0]]}},
    {"id": "search.site.invalid_cql", "op": "GET /rest/api/search", "as": "user", "params": {"cql": "space = = ("},
     "expect": {"400": []}},

    {"id": "auth.token.content_list", "op": "GET /rest/api/content", "as": "token:lab-user-pat", "params": {"spaceKey": "LAB", "type": "page"},
     "note": "The seeded personal access token of lab-user, sent as Authorization: Bearer.",
     "expect": {"200": [["len_ge", "results", 1], ["eq", "results.0.type", "page"]]}},
    {"id": "auth.token.space_get", "op": "GET /rest/api/space/{spaceKey}", "as": "token:lab-user-pat", "path": {"spaceKey": "LAB"},
     "expect": {"200": [["eq", "key", "LAB"]]}},
    {"id": "auth.token.invalid", "op": "GET /rest/api/space/{spaceKey}", "as": "token:invalid", "path": {"spaceKey": "LAB"},
     "needs": "auth.token.space_get", "note": "A bearer token aerie never issued.",
     "expect": {"401": []}},

    {"id": "content.create.success", "op": "POST /rest/api/content", "as": "token:lab-admin-pat", "body": {"type": "page", "title": "Lab Created {cx}", "space": {"key": "LABW"}, "body": {"storage": {"value": "<p>created</p>", "representation": "storage"}}}, "expect": {"200": [["exists", "id"], ["eq", "type", "page"], ["eq", "title", "Lab Created {cx}"], ["eq", "version.number", 1], ["eq", "space.key", "LABW"]]}},
    {"id": "content.create.title_too_long", "op": "POST /rest/api/content", "as": "token:lab-admin-pat", "needs": "content.create.success", "body": {"type": "page", "title": "TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT", "space": {"key": "LABW"}}, "note": "Titles are at most 200 characters (question Q-0013, contracts-v3, behaviour/content.md).", "expect": {"400": []}},
    {"id": "content.update.success", "op": "PUT /rest/api/content/{id}", "as": "token:lab-admin-pat", "setup": [{"op": "POST /rest/api/content", "body": {"type": "page", "title": "W update {cx}", "space": {"key": "LABW"}, "body": {"storage": {"value": "<p>lab write</p>", "representation": "storage"}}}, "save": {"page": "id"}}], "path": {"id": "{page}"}, "body": {"id": "{page}", "type": "page", "title": "W updated {cx}", "version": {"number": 2}, "body": {"storage": {"value": "<p>v2</p>", "representation": "storage"}}}, "expect": {"200": [["eq", "id", "{page}"], ["eq", "version.number", 2], ["eq", "title", "W updated {cx}"]]}},
    {"id": "content.update.conflict", "op": "PUT /rest/api/content/{id}", "as": "token:lab-admin-pat", "setup": [{"op": "POST /rest/api/content", "body": {"type": "page", "title": "W conflict {cx}", "space": {"key": "LABW"}, "body": {"storage": {"value": "<p>lab write</p>", "representation": "storage"}}}, "save": {"page": "id"}}], "path": {"id": "{page}"}, "needs": "content.update.success", "body": {"id": "{page}", "type": "page", "title": "W conflict {cx}", "version": {"number": 5}}, "expect": {"409": []}},
    {"id": "content.delete.success", "op": "DELETE /rest/api/content/{id}", "as": "token:lab-admin-pat", "setup": [{"op": "POST /rest/api/content", "body": {"type": "page", "title": "W delete {cx}", "space": {"key": "LABW"}, "body": {"storage": {"value": "<p>lab write</p>", "representation": "storage"}}}, "save": {"page": "id"}}], "path": {"id": "{page}"}, "note": "aerie always answers 204 (behaviour/content.md).", "expect": {"204": []}},
    {"id": "content.history.success", "op": "GET /rest/api/content/{id}/history", "as": "user", "path": {"id": "{lab_home}"}, "expect": {"200": [["eq", "latest", true], ["exists", "createdBy.username"], ["exists", "createdDate"]]}},
    {"id": "content.version_delete.success", "op": "DELETE /rest/api/content/{id}/version/{versionNumber}", "as": "token:lab-admin-pat", "setup": [{"op": "POST /rest/api/content", "body": {"type": "page", "title": "W version {cx}", "space": {"key": "LABW"}, "body": {"storage": {"value": "<p>lab write</p>", "representation": "storage"}}}, "save": {"page": "id"}}, {"op": "PUT /rest/api/content/{id}", "path": {"id": "{page}"}, "body": {"id": "{page}", "type": "page", "title": "W version {cx}", "version": {"number": 2}, "body": {"storage": {"value": "<p>v2</p>", "representation": "storage"}}}}], "path": {"id": "{page}", "versionNumber": 1}, "expect": {"204": []}},
    {"id": "content.macro_id.success", "op": "GET /rest/api/content/{id}/history/{version}/macro/id/{macroId}", "as": "user", "setup": [{"op": "POST /rest/api/content", "body": {"type": "page", "title": "W macro id {cx}", "space": {"key": "LABW"}, "body": {"storage": {"value": "<ac:structured-macro ac:name=\"info\" ac:schema-version=\"1\" ac:macro-id=\"lab-macro-1\"><ac:rich-text-body><p>lab macro</p></ac:rich-text-body></ac:structured-macro>", "representation": "storage"}}}, "save": {"page": "id"}}], "path": {"id": "{page}", "version": 1, "macroId": "lab-macro-1"}, "expect": {"200": [["eq", "name", "info"], ["exists", "body"]]}},
    {"id": "content.macro_hash.success", "op": "GET /rest/api/content/{id}/history/{version}/macro/hash/{hash}", "as": "user", "setup": [{"op": "POST /rest/api/content", "body": {"type": "page", "title": "W macro hash {cx}", "space": {"key": "LABW"}, "body": {"storage": {"value": "<ac:structured-macro ac:name=\"info\" ac:schema-version=\"1\" ac:macro-id=\"lab-macro-1\"><ac:rich-text-body><p>lab macro</p></ac:rich-text-body></ac:structured-macro>", "representation": "storage"}}}, "save": {"page": "id"}}], "path": {"id": "{page}", "version": 1, "hash": "30d4ef531854fd4a45b87b2cf1fbf82c51ac7081e05d72f982668b9630258eef"}, "note": "The hash is the lowercase hex SHA-256 of the macro's storage markup as written (behaviour/content.md, Macro bodies).", "expect": {"200": [["eq", "name", "info"]]}},
    {"id": "content.child_comments.success", "op": "GET /rest/api/content/{id}/child/comment", "as": "user", "path": {"id": "{lab_home}"}, "note": "aerie holds no comments yet: the list is empty (question Q-0007, contracts-v3, behaviour/content.md).", "expect": {"200": [["eq", "size", 0]]}},
    {"id": "content.descendants.success", "op": "GET /rest/api/content/{id}/descendant", "as": "user", "path": {"id": "{lab_home}"}, "params": {"expand": "page"}, "expect": {"200": [["eq", "page.size", 12]]}},
    {"id": "content.descendants_of_type.success", "op": "GET /rest/api/content/{id}/descendant/{type}", "as": "user", "path": {"id": "{lab_home}", "type": "page"}, "expect": {"200": [["eq", "size", 12], ["exists", "results.0.id"]]}},
    {"id": "content.descendant_count.success", "op": "GET /rest/api/content/{id}/descendant/page/count", "as": "user", "path": {"id": "{lab_home}"}, "expect": {"200": [["eq", "count", 12]]}},
    {"id": "content.scan.success", "op": "GET /rest/api/content/scan", "as": "user", "params": {"spaceKey": "LAB", "limit": 5}, "expect": {"200": [["len_ge", "results", 1], ["len_le", "results", 5], ["exists", "results.0.id"]]}},
    {"id": "content.convert.success", "op": "POST /rest/api/contentbody/convert/{to}", "as": "user", "path": {"to": "view"}, "body": {"value": "<p>lab</p>", "representation": "storage"}, "expect": {"200": [["eq", "representation", "view"], ["exists", "value"]]}},
    {"id": "attachment.create.success", "op": "POST /rest/api/content/{id}/child/attachment", "as": "token:lab-admin-pat", "path": {"id": "{lab_home}"}, "form": {"file": {"__file__": "folder-{cx}.txt", "content": "lab attachment text", "type": "text/plain"}}, "note": "Lab Home is an aerie folder; folders take attachments (question Q-0006, contracts-v3, behaviour/attachments.md).", "expect": {"200": [["eq", "results.0.title", "folder-{cx}.txt"], ["eq", "results.0.type", "attachment"]]}},
    {"id": "attachment.list.success", "op": "GET /rest/api/content/{id}/child/attachment", "as": "user", "setup": [{"op": "POST /rest/api/content", "body": {"type": "page", "title": "W attachments {cx}", "space": {"key": "LABW"}, "body": {"storage": {"value": "<p>lab write</p>", "representation": "storage"}}}, "save": {"page": "id"}}, {"op": "POST /rest/api/content/{id}/child/attachment", "path": {"id": "{page}"}, "form": {"file": {"__file__": "list-{cx}.txt", "content": "lab attachment text", "type": "text/plain"}}, "save": {"att": "results.0.id"}}], "path": {"id": "{page}"}, "params": {"filename": "list-{cx}.txt"}, "note": "aerie answers 200; the published spec lists 201 (behaviour/attachments.md, open questions).", "expect": {"200": [["eq", "size", 1], ["eq", "results.0.title", "list-{cx}.txt"]]}},
    {"id": "attachment.update.success", "op": "PUT /rest/api/content/{id}/child/attachment/{attachmentId}", "as": "token:lab-admin-pat", "setup": [{"op": "POST /rest/api/content", "body": {"type": "page", "title": "W att update {cx}", "space": {"key": "LABW"}, "body": {"storage": {"value": "<p>lab write</p>", "representation": "storage"}}}, "save": {"page": "id"}}, {"op": "POST /rest/api/content/{id}/child/attachment", "path": {"id": "{page}"}, "form": {"file": {"__file__": "update-{cx}.txt", "content": "lab attachment text", "type": "text/plain"}}, "save": {"att": "results.0.id"}}], "path": {"id": "{page}", "attachmentId": "{att}"}, "body": {"id": "{att}", "type": "attachment", "version": {"number": 2}, "metadata": {"comment": "updated"}}, "expect": {"200": [["eq", "id", "{att}"], ["eq", "extensions.comment", "updated"]]}},
    {"id": "attachment.delete.success", "op": "DELETE /rest/api/content/{id}/child/attachment/{attachmentId}", "as": "token:lab-admin-pat", "setup": [{"op": "POST /rest/api/content", "body": {"type": "page", "title": "W att delete {cx}", "space": {"key": "LABW"}, "body": {"storage": {"value": "<p>lab write</p>", "representation": "storage"}}}, "save": {"page": "id"}}, {"op": "POST /rest/api/content/{id}/child/attachment", "path": {"id": "{page}"}, "form": {"file": {"__file__": "delete-{cx}.txt", "content": "lab attachment text", "type": "text/plain"}}, "save": {"att": "results.0.id"}}], "path": {"id": "{page}", "attachmentId": "{att}"}, "expect": {"204": []}},
    {"id": "attachment.data.success", "op": "POST /rest/api/content/{id}/child/attachment/{attachmentId}/data", "as": "token:lab-admin-pat", "setup": [{"op": "POST /rest/api/content", "body": {"type": "page", "title": "W att data {cx}", "space": {"key": "LABW"}, "body": {"storage": {"value": "<p>lab write</p>", "representation": "storage"}}}, "save": {"page": "id"}}, {"op": "POST /rest/api/content/{id}/child/attachment", "path": {"id": "{page}"}, "form": {"file": {"__file__": "data-{cx}.txt", "content": "lab attachment text", "type": "text/plain"}}, "save": {"att": "results.0.id"}}], "path": {"id": "{page}", "attachmentId": "{att}"}, "form": {"file": {"__file__": "data-{cx}.txt", "content": "new bytes", "type": "text/plain"}}, "expect": {"200": [["eq", "id", "{att}"], ["eq", "extensions.fileSize", 9]]}},
